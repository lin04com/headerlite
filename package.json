{
  "name": "headerlite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "修改 HTTP 请求头/响应头与重定向 URL 的 Chrome MV3 扩展（核心版）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
